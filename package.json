{
  "name": "player-app",
  "productName": "Lull",
  "version": "1.0.0",
  "private": true,
  "description": "Lull — музыка, которая знает тебя",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --dir",
    "test:import": "node scripts/test-import.mjs",
    "build:web": "vite build --mode web",
    "dev:webapp": "vite --mode web",
    "build:api": "node server-api/build.mjs",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@braccato/core": "^1.16.13",
    "@braccato/parsers": "^0.4.0",
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "6.0.3",
    "@capacitor/core": "6.2.2",
    "@capacitor/splash-screen": "6.0.4",
    "@capacitor/status-bar": "6.0.3",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/unbounded": "^5.3.0",
    "@jofr/capacitor-media-session": "4.0.0",
    "@kawarp/core": "^1.3.1",
    "@kawarp/react": "^1.3.1",
    "@xhayper/discord-rpc": "^1.5.1",
    "bgutils-js": "^4.0.3",
    "framer-motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "simple-icons": "^16.36.0",
    "youtubei.js": "^18.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "author": {
    "name": "Lull",
    "email": "bin985100@gmail.com"
  },
  "homepage": "https://lull.website"
}
