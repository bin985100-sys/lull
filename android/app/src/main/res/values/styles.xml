<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#0B0B0E</item>
        <item name="colorPrimaryDark">#0B0B0E</item>
        <item name="colorAccent">#F5F5F7</item>
        <item name="android:windowBackground">@color/lull_bg</item>
        <item name="android:statusBarColor">@color/lull_bg</item>
        <item name="android:navigationBarColor">@color/lull_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/lull_bg</item>
        <item name="android:statusBarColor">@color/lull_bg</item>
        <item name="android:navigationBarColor">@color/lull_bg</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lull_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/lull_bg</item>
        <item name="android:navigationBarColor">@color/lull_bg</item>
    </style>
</resources>
